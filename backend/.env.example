# GitHub配置（可选，不填则限制60次/小时，填写后提升至5000次/小时）
GITHUB_TOKEN=

# AI模型配置（必填，用于翻译和摘要）
# OpenAI兼容接口配置
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 应用配置
APP_VERSION=1.0.0
DEBUG=true

# CORS配置（前端地址）
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
